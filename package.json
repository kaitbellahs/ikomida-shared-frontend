{
  "name": "@ikomida/shared-frontend",
  "version": "1.3.40",
  "description": "the iKomida fromntend shared code",
  "private": false,
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "svelte": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "README.md",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build:clean": "rimraf ./build ./lib ./docs",
    "glogin": "artifactregistry-auth",
    "build": "yarn build:clean && yarn build:js && yarn build:svelte",
    "build:win": "yarn build:clean && yarn build:svelte:win && yarn build:js",
    "build:js": "tsc",
    "build:svelte": "cp ./src/components/*.svelte ./lib/components/",
    "build:svelte:win": "yarn cpy ./src/components/*.svelte ./lib/components/",
    "format": "prettier --write ./src",
    "clean": "git status --ignored -u --porcelain . | grep -v node_modules/ | grep -e '^!! ' | sed 's/^!! packages\\/[a-z-]*\\///g' | tr '\\n' ' ' | xargs rm",
    "prepare": "yarn build",
    "sveltecheck": "svelte-check --tsconfig ./tsconfig.json --ignore lib --use-new-transformation  true",
    "local": "yarn glogin && ncu -u && yarn && yarn format && yarn sveltecheck && yarn build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@capacitor-community/date-picker": "^0.2.3",
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/app": "^4.0.1",
    "@capacitor/app-launcher": "^4.0.1",
    "@capacitor/clipboard": "^4.0.1",
    "@capacitor/core": "^4.3.0",
    "@capacitor/device": "^4.0.1",
    "@capacitor/preferences": "^4.0.1",
    "@capacitor/push-notifications": "^4.1.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@tsconfig/svelte": "^3.0.0",
    "@types/lodash": "^4.14.186",
    "@types/uuid": "^8.3.4",
    "prettier": "^2.7.1",
    "reflect-metadata": "^0.1.13",
    "svelte": "^3.52.0",
    "svelte-check": "^2.9.2",
    "svelte-fa": "^3.0.3",
    "svelte-strip": "^1.0.2",
    "svelte2tsx": "^0.5.20",
    "tslib": "^2.4.0",
    "typescript": "^4.8.4",
    "typescript-svelte-plugin": "^0.3.10"
  },
  "peerDependencies": {
    "@capacitor-community/date-picker": "*",
    "@capacitor-community/http": "*",
    "@capacitor/app": "*",
    "@capacitor/app-launcher": "*",
    "@capacitor/clipboard": "*",
    "@capacitor/core": "*",
    "@capacitor/device": "*",
    "@capacitor/preferences": "*",
    "@capacitor/push-notifications": "*",
    "@fortawesome/free-solid-svg-icons": "*",
    "svelte-fa": "*",
    "uuid": "*"
  },
  "dependencies": {
    "@ikomida/shared-logics": "^1.0.7",
    "@ikomida/shared-types": "^1.3.7",
    "jose": "^4.10.3",
    "lodash": "^4.17.21",
    "react-image-file-resizer": "^0.4.8"
  }
}